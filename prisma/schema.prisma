generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  ARTICLE
  VIDEO_EMBED
}

enum ClipMarkKind {
  INTERESTING
  UNINTERESTING
  INFORMATIVE
}

enum ScrapeStatus {
  SUCCESS
  ERROR
}

model User {
  id         String     @id @default(cuid())
  publicId   String     @unique
  email        String     @unique
  emailHash    String?    @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  bio          String?
  karma      Int        @default(0)
  nameHash   String?    @unique
  createdAt  DateTime   @default(now())
  posts      Post[]
  comments   Comment[]
  votes        Vote[]
  commentLikes CommentLike[]
  seenPosts    SeenPost[]
  sessions     Session[]
  exitVotes    ExitVote[]
  keptLines    KeptLine[]
  passesSent   ClipPass[]  @relation("PassFrom")
  passesGot    ClipPass[]  @relation("PassTo")
  lineOffers   LineOffer[]
  linePicks    LinePick[]
  doorPicks    DoorPick[]
  deskFollows  DeskFollow[]
  sourceFollows SourceFollow[]
  corrections  Correction[]
  clipMarks    ClipMark[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Post {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  publicId       String      @unique
  contentType    ContentType
  sourceUrl      String?     @unique
  sourceName     String
  embedUrl       String?
  thumbnailUrl   String?
  category       String
  rawContent     String?     @db.Text
  remixedContent Json?
  upvotesCount   Int         @default(0)
  commentCount   Int         @default(0)
  isAutomated    Boolean     @default(true)
  createdAt      DateTime    @default(now())
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes          Vote[]
  comments       Comment[]
  seenBy         SeenPost[]
  exitVotes      ExitVote[]
  keptLines      KeptLine[]
  passes         ClipPass[]
  lineOffers     LineOffer[]
  doorPicks      DoorPick[]  @relation("DoorChosen")
  doorOthers     DoorPick[]  @relation("DoorOther")
  corrections    Correction[]
  clipMarks      ClipMark[]

  @@index([createdAt])
  @@index([commentCount])
  @@index([category, createdAt])
  @@index([contentType, createdAt])
  @@index([isAutomated, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  likeCount Int       @default(0)
  likes     CommentLike[]
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model SeenPost {
  id     String   @id @default(cuid())
  userId String
  postId String
  seenAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, seenAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  value     Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model ExitVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  worth     Boolean
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model KeptLine {
  id         String   @id @default(cuid())
  userId     String
  postId     String
  line       String
  sourceName String
  sourceUrl  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model ClipPass {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  postId     String
  seenAt     DateTime?
  createdAt  DateTime  @default(now())
  fromUser   User      @relation("PassFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User      @relation("PassTo", fields: [toUserId], references: [id], onDelete: Cascade)
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([toUserId, seenAt])
}

model LineOffer {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  line      String
  picks     Int        @default(0)
  flags     Int        @default(0)
  pulled    Boolean    @default(false)
  createdAt DateTime   @default(now())
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  picksBy   LinePick[]

  @@index([postId, pulled, picks])
  @@index([userId])
}

model LinePick {
  id        String    @id @default(cuid())
  offerId   String
  userId    String
  offer     LineOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([offerId, userId])
}

model DoorPick {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  otherId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation("DoorChosen", fields: [postId], references: [id], onDelete: Cascade)
  other     Post     @relation("DoorOther", fields: [otherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId, otherId])
  @@index([userId, createdAt])
}

model DeskFollow {
  id        String   @id @default(cuid())
  userId    String
  desk      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, desk])
  @@index([userId])
}

model SourceFollow {
  id         String   @id @default(cuid())
  userId     String
  sourceName String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, sourceName])
  @@index([userId])
}

model Correction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  note      String
  pulled    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([pulled, createdAt])
}

model ClipMark {
  id        String       @id @default(cuid())
  userId    String
  postId    String
  kind      ClipMarkKind
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, postId])
  @@index([postId, kind])
}

model ScrapeLog {
  id           String       @id @default(cuid())
  sourceUrl    String
  status       ScrapeStatus
  errorDetails String?      @db.Text
  createdAt    DateTime     @default(now())

  @@index([createdAt])
}
