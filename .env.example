# On a public server, point this at a pooled database so many visitors share a small set of connections.
DATABASE_URL="postgresql://forge:forge@localhost:5432/forge?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
# Encrypts account email, username, and profile pictures. Required in production.
# Keep the same value forever. Changing it makes stored account fields unreadable.
# Local development uses AUTH_SECRET when this is unset.
DATA_KEY="replace-with-a-different-long-random-string"
APP_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM="Forge <noreply@example.com>"
# On a long-running Node server, true runs the collector inside the app.
# On Vercel, the in-app collector stays off and Vercel Cron calls /api/cron.
ENABLE_WORKER="true"
SCRAPE_ON_BOOT="true"
CRON_SCHEDULE="0 */12 * * *"
CRON_SECRET="replace-with-a-long-random-string"
